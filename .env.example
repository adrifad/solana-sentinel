# Start in read-only analysis mode. PAPER is virtual only; LIVE is unsupported.
APP_MODE=DRY_RUN
APP_CONFIG_PATH=config/default.yaml
DB_PATH=./data/sentinel.db

# Provider credentials are optional for offline CLI/API commands. Worker start
# requires PumpPortal to be configured. Never expose the PumpPortal key: it may
# be linked to a funded wallet.
PUMPPORTAL_API_KEY=
HELIUS_API_KEY=

API_HOST=127.0.0.1
API_PORT=8787

# Required for authenticated manual PAPER entry/exit requests; generate a
# random value of at least 32 characters. Keep empty while running DRY_RUN.
PAPER_OPERATOR_TOKEN=

# Optional independent Telegram read-only monitor. Keep disabled until an
# operator has configured BotFather credentials and strict user/chat allowlists.
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ALLOWED_USER_IDS=
