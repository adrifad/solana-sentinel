# Start in read-only analysis mode. PAPER and LIVE are not implemented here.
APP_MODE=DRY_RUN
APP_CONFIG_PATH=config/default.yaml
DB_PATH=./data/sentinel.db

# Provider credentials are optional for offline CLI/API commands. Worker start
# requires PumpPortal to be configured. Never expose the PumpPortal key: it may
# be linked to a funded wallet.
PUMPPORTAL_API_KEY=
HELIUS_API_KEY=

API_HOST=127.0.0.1
API_PORT=8787
