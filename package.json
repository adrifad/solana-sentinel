{
  "name": "solana-sentinel",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.3.0",
  "type": "module",
  "engines": {
    "node": ">=24 <27"
  },
  "scripts": {
    "build": "tsc --noEmit && pnpm --filter @sentinel/web build",
    "typecheck": "tsc --noEmit && pnpm --filter @sentinel/web typecheck",
    "lint": "eslint apps packages tests scripts eslint.config.js",
    "format:check": "prettier --check .",
    "docs:check": "node scripts/check-doc-links.mjs",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "db:migrate": "node --env-file-if-exists=.env --experimental-strip-types apps/worker/src/main.ts migrate",
    "dev:worker": "node --env-file-if-exists=.env --experimental-strip-types apps/worker/src/main.ts start",
    "dev:api": "node --env-file-if-exists=.env --experimental-strip-types apps/api/src/main.ts",
    "dev:telegram-bot": "node --env-file-if-exists=.env --experimental-strip-types apps/telegram-bot/src/main.ts",
    "dev:web": "pnpm --filter @sentinel/web dev",
    "tokens": "node --env-file-if-exists=.env --experimental-strip-types apps/worker/src/main.ts tokens",
    "health": "node --env-file-if-exists=.env --experimental-strip-types apps/worker/src/main.ts health",
    "validate:providers": "node --env-file-if-exists=.env --experimental-strip-types scripts/validate-providers.ts",
    "validate:trade-events": "node --env-file-if-exists=.env --experimental-strip-types scripts/validate-trade-events.ts"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@types/ws": "^8.18.1",
    "@sentinel/config": "workspace:*",
    "@sentinel/domain": "workspace:*",
    "@sentinel/intelligence": "workspace:*",
    "@sentinel/providers": "workspace:*",
    "@sentinel/paper": "workspace:*",
    "@sentinel/security": "workspace:*",
    "@sentinel/storage": "workspace:*",
    "@sentinel/strategy": "workspace:*",
    "@sentinel/api": "workspace:*",
    "eslint": "^9.39.1",
    "prettier": "^3.6.2",
    "typescript-eslint": "^8.48.0",
    "typescript": "^5.9.3",
    "yaml": "^2.8.1"
  }
}
